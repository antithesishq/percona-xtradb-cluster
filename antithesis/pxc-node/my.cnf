# Shared PXC config for the Antithesis harness.
#
# Derived from deployment-topology.md "Config sketch (my.cnf per node)".
# Per-node settings (node name, addresses) are generated by the entrypoint
# into /etc/my.cnf.d/node.cnf from the environment.
#
# Guiding rule from the topology: everything not listed here stays at its REAL
# default. In particular do NOT copy MTR's relaxed failure-detector timers
# (evs.suspect, evs.inactive, evs.install, pc.announce, max_install_timeouts).
# MTR relaxes those to AVOID membership churn; Antithesis wants failure
# detection at field settings, because that churn is the point.

[mysqld]
user                            = mysql
datadir                         = /var/lib/mysql
socket                          = /var/lib/mysql/mysql.sock
pid-file                        = /var/run/mysqld/mysqld.pid
bind-address                    = 0.0.0.0
skip-name-resolve

# Log to a file so the supervisor can tail it and so performance_schema.error_log
# is populated for the workload to read over SQL.
log-error                       = /var/log/mysql/error.log

# --- Startup-fatal PXC requirements (mysqld.cc; PXC-3129) -------------------
# mysqld refuses to start if these are wrong, so they are not optional.
default-storage-engine          = InnoDB
binlog_format                   = ROW
innodb_autoinc_lock_mode        = 2
log_output                      = FILE
# innodb_page_size is deliberately NOT set: PXC requires the 16384 default.

# --- Durability -------------------------------------------------------------
# Field defaults kept on purpose. MTR always runs flush_log_at_trx_commit=2;
# we do not, because crash-recovery properties depend on real durability.
innodb_flush_log_at_trx_commit  = 1
sync_binlog                     = 1

# --- GTID -------------------------------------------------------------------
# Required, not optional: 8.4 defaults gtid_mode=OFF, which mints no GTIDs on
# the wsrep path at all and makes gtid-executed-cluster-convergence vacuous.
# This trio matches the vendor's own galera_gtid-master.opt.
# Side effect: enforce_gtid_consistency restricts CREATE TEMPORARY TABLE inside
# transactions — the workload avoids temp tables anyway.
gtid_mode                       = ON
enforce_gtid_consistency        = ON
log_replica_updates             = ON

# --- Memory -----------------------------------------------------------------
# Small; Antithesis hosts are memory-constrained.
# Known distortion: the gcs recv queue is sized from HOST memory and is
# cgroup-blind, so it does not shrink along with this.
innodb_buffer_pool_size         = 256M

# --- wsrep ------------------------------------------------------------------
wsrep_provider                  = /usr/local/pxc/lib/libgalera_smm.so
wsrep_cluster_name              = antithesis-pxc
wsrep_cluster_address           = gcomm://10.20.20.11,10.20.20.12,10.20.20.13
wsrep_sst_method                = xtrabackup-v2

# >1 applier unlocks the PXC-4652/4657 class of bugs. The field default of 1
# under-exercises the applier path everywhere.
wsrep_applier_threads           = 4

# wsrep_sync_wait is deliberately NOT set — the server default of 0 (stale
# reads permitted) is the shipped contract. Workload sessions set it per
# property set (0 vs 1/7).

# v1 simplification. TLS sits below every subsystem under test and adds cert
# plumbing without covering new target code. Cost: the TLS findings from
# sut-analysis §8.2 are untestable until a TLS variant image exists.
pxc_encrypt_cluster_traffic     = OFF

# pxc_strict_mode is left at the ENFORCING default. It blocks PK-less DML,
# non-InnoDB DML and LOCK TABLES, which several properties need — but it is
# dynamic, so those legs lower it at run time and restore it afterwards.
#
# pxc_maint_transition_period is left at its default 10. The 10s sleep in the
# SIGTERM path is itself interesting behavior; the harness compensates with
# stop_grace_period: 90s in docker-compose.yaml rather than by tuning it here.
#
# wsrep_notify_cmd is NOT set here. It is READ_ONLY, so the notify-cmd
# properties need a config variant that adds:
#     wsrep_notify_cmd = /opt/antithesis/pxc/notify.sh
# The script is already baked into the image and ready for that variant.

# gcache.size=16M, not the 128M default: at 128M, IST always succeeds in a
# short run and the SST path, donor-selection races and gcache rollover are
# never reached. 16M puts the IST/SST boundary inside normal workload volume.
# Tune after the first runs — target a healthy IST/SST mix, not all-SST.
#
# repl.force_sst_after_inconsistency is deliberately absent: the default "no"
# is the pre-fix field behavior tested first, and the option is runtime-settable
# via SET GLOBAL wsrep_provider_options, so the opt-in arm needs no variant.
wsrep_provider_options          = "gcache.size=16M"

!includedir /etc/my.cnf.d/
